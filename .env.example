# Copy to .env (Git-ignored) and fill in one provider. The server reads it on start; the browser never sees it.
# AI_PROVIDER: anthropic | openai | school | none   (none = rule ranking only)
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# Optional overrides
# AI_MODEL=claude-opus-5-5
# AI_EFFORT=low
# AI_TIMEOUT_MS=20000

# ChatGPT
# OPENAI_API_KEY=
# OPENAI_MODEL=

# School-provided AI (assumes an OpenAI-compatible /chat/completions endpoint; confirm with the school)
# SCHOOL_AI_BASE_URL=
# SCHOOL_AI_API_KEY=
# SCHOOL_AI_MODEL=
